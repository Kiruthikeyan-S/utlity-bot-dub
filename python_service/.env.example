# ==============================================================================
# Utility Bot - Backend Environment Configuration (.env)
# ==============================================================================

# MongoDB Atlas Configuration
# Required for production cloud persistence with automatic owner-scoped queries and 30-day retention
# Example: mongodb+srv://<username>:<password>@cluster0.cvyb4e4.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=utility_bot_history

# Firebase Admin Authentication
# Matches your frontend Firebase project. Used by backend to cryptographically verify ID tokens.
FIREBASE_PROJECT_ID=utility-bot-web

# Optional: Path to Firebase Service Account JSON file (or raw JSON string)
# If omitted, Firebase Admin verifies tokens against Google's public x509 certificates for FIREBASE_PROJECT_ID
FIREBASE_SERVICE_ACCOUNT_KEY=

# Groq Cloud LLM API Configuration (Optional)
# If left blank, the app falls back to built-in 100% local RapidOCR engine
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
